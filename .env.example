# Copy this file to .env.local and fill in the values.

# MongoDB connection string, including the database name.
# Local:  mongodb://127.0.0.1:27017/warrant
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/warrant
MONGODB_URI=

# Random secret used to sign sessions. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# The site's public URL. http://localhost:3000 locally, your Vercel URL in production.
NEXTAUTH_URL=http://localhost:3000

# Optional: GitHub sign-in. Leave blank to hide the "Continue with GitHub" button.
# Callback URL for the OAuth app: <NEXTAUTH_URL>/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# Only used by `npm run seed`: password for the demo account (demo@warrant.dev).
SEED_DEMO_PASSWORD=
